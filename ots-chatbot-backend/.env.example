# Comma-separated browser origins allowed by CORS
# HAWK_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Comma-separated sites allowed to embed the chat widget (sent as CSP frame-ancestors).
# The default allows the local widget test page. For the OSL site, add https://www.iit.edu
# HAWK_FRAME_ANCESTORS=http://localhost:8002,http://127.0.0.1:8002,https://www.iit.edu

# How long Ollama keeps the model in memory after the last request (default 60m).
# Examples: 30m, 2h, -1 (until Ollama restarts). Reloading takes ~5 s on a laptop CPU.
# HAWK_OLLAMA_KEEP_ALIVE=60m
